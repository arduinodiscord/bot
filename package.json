{
  "name": "arduino-bot",
  "description": "The new and improved custom discord bot to power the official Arduino discord server @ https://arduino.cc/discord",
  "version": "1.0.0",
  "main": "./dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./dist/src/index.js",
    "build": "tsc -p .",
    "dev": "tsc -p . && (tsc -p . -w --preserveWatchOutput & node --watch-path=./dist ./dist/src/index.js)",
    "postinstall": "prisma generate",
    "test": "tsc -p . && BOT_TOKEN=test node --test \"dist/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arduinodiscord/bot.git"
  },
  "bugs": {
    "url": "https://github.com/arduinodiscord/bot/issues"
  },
  "homepage": "https://github.com/arduinodiscord/bot#readme",
  "author": "Max Bromberg and Contributors",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sapphire/framework": "^5.5.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "jimp": "^1.6.1",
    "pg": "^8.21.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@sapphire/ts-config": "^5.0.3",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  }
}
