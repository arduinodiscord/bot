generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Analytics rows are keyed by a surrogate id. `time` used to be the primary
// key, so two events in the same millisecond (a raid's joins) collided (P2002).
model MemberAnalytics {
  id       Int                  @id @default(autoincrement())
  time     DateTime             @default(now()) @db.Timestamptz(6)
  event    MemberAnalyticsEvent
  memberId String               @db.VarChar

  @@index([time])
}

model MessageAnalytics {
  id        Int      @id @default(autoincrement())
  time      DateTime @default(now()) @db.Timestamptz(6)
  memberId  String?  @db.VarChar
  channelId String?  @db.VarChar

  @@index([time])
}

model CommandAnalytics {
  id      Int      @id @default(autoincrement())
  time    DateTime @default(now()) @db.Timestamptz(6)
  command String?  @db.VarChar

  @@index([time])
}

enum MemberAnalyticsEvent {
  join
  leave
}

/// Blocklist of image fingerprints confirmed to be spam by a moderator.
/// New uploads matching one of these are auto-actioned. `kind` is "meta" for
/// exact metadata signatures or "phash" for perceptual hashes (matched by
/// Hamming distance). `severity` distinguishes "scam" (auto-ban on reappearance)
/// from "spam" (timeout).
model SpamSignature {
  signature String   @id @db.VarChar
  kind      String   @default("sha") @db.VarChar // "sha" (content id) | "phash"
  addedBy   String   @db.VarChar
  reason    String?  @db.VarChar
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  severity  String   @default("spam") @db.VarChar // "scam" | "spam"
}

/// Allowlist of image fingerprints that are known-good (negative-training set).
/// Signatures here suppress spam alerts even if they match a SpamSignature cluster.
model AllowSignature {
  id        Int      @id @default(autoincrement())
  signature String   @unique @db.VarChar
  kind      String   @db.VarChar // "sha" (content id); allowlisting is exact-only
  addedBy   String   @db.VarChar
  reason    String?  @db.VarChar
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

/// Keywords learned from OCR of confirmed scam images.
model ScamKeyword {
  keyword   String   @id @db.VarChar
  hits      Int      @default(1)
  addedBy   String   @db.VarChar
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

/// Audit trail of automod-related moderation actions.
model ModerationAction {
  id          String   @id @default(uuid())
  time        DateTime @default(now()) @db.Timestamptz(6)
  moderatorId String   @db.VarChar
  targetId    String   @db.VarChar
  action      String   @db.VarChar
  reason      String?  @db.VarChar
}
